# Uploaded images only: never run scripts from this folder
<FilesMatch "\.(?i:php\d?|phtml|phar|pl|py|cgi|sh|shtml)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
Options -ExecCGI
